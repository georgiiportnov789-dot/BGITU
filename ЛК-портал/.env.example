# Секретный ключ Django (в проде — обязателен свой)
DJANGO_SECRET_KEY=change-me-in-production
# Разрешённые хосты через запятую
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# База: sqlite (по умолчанию) или postgres
DB_ENGINE=sqlite
# POSTGRES_DB=bgitu
# POSTGRES_USER=bgitu
# POSTGRES_PASSWORD=
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
